# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# NOTICE: Use ONLY synthetic/neutral placeholders. NEVER commit actual credentials,
# private API keys, or personal owner information to this file or version control.
# ==============================================================================

# Core Platform Settings
NODE_ENV=development
PORT=3000
API_PORT=4000
NEXT_PUBLIC_APP_NAME="Vespera Atelier"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://db_user:db_password_placeholder@localhost:5432/fashion_marketplace?schema=public"

# Security & Session Authentication Secrets
# Generated using cryptographically secure random bytes (e.g., openssl rand -base64 32)
JWT_SECRET="replace-with-min-32-byte-cryptographically-secure-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace-with-min-32-byte-cryptographically-secure-random-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"
SESSION_COOKIE_SECRET="replace-with-min-32-byte-cryptographically-secure-random-secret"

# Super Admin / Owner Bootstrap Security
# Used only during initial one-time server bootstrap via locked CLI script.
# MUST NOT BE ACCESSIBLE VIA ANY HTTP SETUP ROUTE OR BROWSER PAGE.
OWNER_BOOTSTRAP_INVITE_TOKEN="replace-with-secure-single-use-bootstrap-token"

# Multi-Factor Authentication (MFA / TOTP)
MFA_ENCRYPTION_KEY="replace-with-32-byte-hex-aes256-key"

# Private S3-Compatible Object Storage (Seller KYC & Product Raw Assets)
STORAGE_ENDPOINT="https://storage-region.example.com"
STORAGE_BUCKET_PRIVATE_DOCS="marketplace-private-kyc"
STORAGE_BUCKET_PUBLIC_MEDIA="marketplace-public-media"
STORAGE_ACCESS_KEY="replace-with-storage-access-key-placeholder"
STORAGE_SECRET_KEY="replace-with-storage-secret-key-placeholder"
STORAGE_REGION="us-east-1"
STORAGE_FORCE_PATH_STYLE="false"

# Payment Gateway (Mock/Sandbox Placeholders - E.g. Razorpay / Stripe)
PAYMENT_GATEWAY_PROVIDER="sandbox"
PAYMENT_PUBLIC_KEY="pk_test_sample_placeholder"
PAYMENT_SECRET_KEY="sk_test_sample_placeholder"
PAYMENT_WEBHOOK_SECRET="whsec_sample_placeholder"

# Transactional Email / Communications (Transactional Only - No Marketing Without Consent)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="sample_user_placeholder"
SMTP_PASSWORD="sample_password_placeholder"
PUBLIC_SUPPORT_EMAIL="support@example-marketplace.com"
PUBLIC_GRIEVANCE_EMAIL="grievance@example-marketplace.com"

# Shipping & Logistics Partner API (Sandbox)
LOGISTICS_API_ENDPOINT="https://api-sandbox.logistics-partner.example.com"
LOGISTICS_API_KEY="logistics_sandbox_key_placeholder"
LOGISTICS_WEBHOOK_SECRET="logistics_webhook_secret_placeholder"

# Rate Limiting & Abuse Prevention
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
