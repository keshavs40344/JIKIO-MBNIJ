// Prisma Schema — Vespera Atelier Foundation
// Database provider: PostgreSQL
// Phase 3 Foundation Schema (Identity, Roles, Sessions, MFA, Seller Verification, Audit Events)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  SELLER_APPLICANT
  APPROVED_SELLER
  CATALOG_MODERATOR
  FINANCE_OPERATOR
  SUPER_ADMIN
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum DocumentType {
  GST_CERTIFICATE
  BUSINESS_PAN
  BANK_CANCELLED_CHEQUE
  BRAND_AUTHORIZATION_LETTER
  SUPPLIER_INVOICE
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  phone           String?           @unique
  passwordHash    String
  role            UserRole          @default(CUSTOMER)
  isActive        Boolean           @default(true)
  isMfaEnabled    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sessions        Session[]
  mfaFactors      MfaFactor[]
  sellerProfile   SellerProfile?
  auditLogs       SecurityAuditEvent[] @relation("ActorAuditLogs")

  @@index([email])
  @@index([role])
}

model Session {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  ipHash          String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model MfaFactor {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  factorType      String    @default("TOTP")
  secretEncrypted String
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model SellerProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName           String             @unique
  businessGstin       String?            @unique
  businessPan         String?
  registeredAddress   String?
  verificationStatus  VerificationStatus @default(DRAFT)
  rejectionReason     String?
  verifiedAt          DateTime?
  verifiedByUserId    String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  documents           SellerDocument[]

  @@index([verificationStatus])
}

model SellerDocument {
  id                 String             @id @default(uuid())
  sellerId           String
  seller             SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  documentType       DocumentType
  privateStorageKey  String             @unique
  originalFileName   String
  mimeType           String
  fileSizeBytes      Int
  verificationStatus VerificationStatus @default(SUBMITTED)
  reviewedByUserId   String?
  reviewedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())

  @@index([sellerId])
}

model SecurityAuditEvent {
  id              String    @id @default(uuid())
  actorId         String?
  actor           User?     @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole       String
  action          String
  targetType      String
  targetId        String?
  ipHash          String?
  detailsSanitized Json
  createdAt       DateTime  @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

